{
  "name": "njt-reliability-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent reliability tracking for NJ Transit commuter rail.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "db",
    "pipeline",
    "api",
    "app"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:comments": "tsx scripts/check-comments-only.ts",
    "generate:contract": "tsx scripts/generate-contract.ts",
    "emit:data-contract": "tsx scripts/emit-data-contract.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "pipeline": "tsx pipeline/src/main.ts",
    "api": "tsx api/src/main.ts",
    "import:gtfs": "tsx pipeline/src/gtfs/import.ts",
    "build:geo": "tsx pipeline/src/geo/build-outline.ts",
    "import:official": "tsx pipeline/src/official/import.ts",
    "repair:line-names": "tsx pipeline/src/gtfs/repair.ts",
    "purge:seed": "tsx pipeline/src/maintenance/purge-seed.ts",
    "replay": "tsx pipeline/src/replay/cli.ts",
    "snapshot": "tsx pipeline/src/maintenance/snapshot-cli.ts",
    "compact": "tsx pipeline/src/maintenance/compact-cli.ts",
    "verify:restore": "tsx pipeline/src/maintenance/verify-restore-cli.ts",
    "monitors:sync": "tsx scripts/sync-monitors.ts",
    "export:events": "tsx pipeline/src/archive/export-cli.ts",
    "archive:copy": "tsx pipeline/src/archive/copy-cli.ts",
    "import:predictions": "tsx pipeline/src/predictions/import-cli.ts",
    "export:predictions": "tsx pipeline/src/replay/export-predictions.ts",
    "dev:fixture": "tsx pipeline/src/maintenance/dev-fixture-cli.ts",
    "bootstrap": "npm run import:gtfs && npm run import:official",
    "start:server": "node deploy/start.mjs",
    "app": "npm run start --workspace app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "3.2.6",
    "fast-check": "^4.9.0",
    "ts-to-zod": "^5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "zod": "^4.4.3"
  }
}
