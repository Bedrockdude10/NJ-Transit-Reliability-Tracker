# NJ Transit Reliability Tracker — environment template.
# Copy to .env (gitignored). Never commit real credentials.

# ── Database ───────────────────────────────────────────────────────────────
NJT_DB_PATH=./data/njt.sqlite

# ── Pipeline: NJT rail-data credentials ──────────────────────────────────────
# GTFS + GTFS-RT: register at developer.njtransit.com. Auth is token-based —
# the pipeline POSTs these to getToken and caches the returned token itself.
NJT_RAIL_DATA_USERNAME=
NJT_RAIL_DATA_PASSWORD=
# Base URL: production by default. Use the test host to verify without spending
# the production getToken quota (10/day):
#   https://testraildata.njtransit.com/api/GTFSRT
NJT_RAIL_DATA_BASE_URL=https://raildata.njtransit.com/api/GTFSRT

# XML train-control API: register at datasource.njtransit.com
NJT_XML_API_KEY=
NJT_XML_URL=

# ── Pipeline: keyless one-time source URLs (optional) ────────────────────────
NJT_GTFS_STATIC_URL=
NJT_OFFICIAL_CSV_URL=

# Directory of NJT's per-line performance CSVs for `npm run import:official` (keyless).
NJT_PERFORMANCE_DIR=./data

# ── Pipeline: polling intervals (ms) — defaults shown ────────────────────────
NJT_TRIP_UPDATES_INTERVAL_MS=30000
NJT_VEHICLE_POSITIONS_INTERVAL_MS=60000
NJT_SERVICE_ALERTS_INTERVAL_MS=60000
NJT_XML_INTERVAL_MS=60000
NJT_HOURLY_RECOMPUTE_MS=3600000
NJT_STALENESS_CHECK_MS=300000

# Alert if no successful TripUpdates ingest within this window (ms). Also the
# threshold `/health/live` answers 503 past, which is what uptime monitoring
# watches — the API stays up when the pipeline dies, so `/health` alone cannot
# see a stalled feed.
NJT_NO_TRIP_UPDATES_ALERT_MS=3600000
# Optional webhook (e.g. Slack) for staleness alerts.
NJT_ALERT_WEBHOOK_URL=

# ── API ──────────────────────────────────────────────────────────────────────
PORT=4000

# ── Frontend (Expo) ──────────────────────────────────────────────────────────
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time.
EXPO_PUBLIC_API_URL=http://localhost:4000

# ── Uptime monitoring (`npm run monitors:sync`) ──────────────────────────────
# Better Stack → Settings → API tokens. Only needed to apply deploy/monitors.json;
# nothing at runtime reads it.
BETTERSTACK_API_TOKEN=
# The deployed API's public base URL, the thing the monitors point at.
NJT_PUBLIC_API_URL=
