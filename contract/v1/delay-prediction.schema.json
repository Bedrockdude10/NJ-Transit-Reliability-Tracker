{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://njt-reliability-tracker/contract/v1/delay-prediction.schema.json",
  "title": "DelayPrediction",
  "description": "A predicted terminal delay. Written by njt-delay-modeling, read by the API. Object-storage prefix: predictions/",
  "type": "object",
  "properties": {
    "tripId": {
      "type": "string"
    },
    "lineName": {
      "type": "string"
    },
    "serviceDate": {
      "type": "string"
    },
    "fromStopId": {
      "type": "string"
    },
    "toStopId": {
      "type": "string"
    },
    "predictedAtEpochSeconds": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "horizonSeconds": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "predictedDelaySeconds": {
      "type": "number"
    },
    "actualDelaySeconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelVersion": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    }
  },
  "required": [
    "tripId",
    "lineName",
    "serviceDate",
    "fromStopId",
    "toStopId",
    "predictedAtEpochSeconds",
    "horizonSeconds",
    "predictedDelaySeconds",
    "actualDelaySeconds",
    "modelVersion",
    "runId"
  ],
  "additionalProperties": false
}
