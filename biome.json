{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/.claude/", "!**/*.zod.ts"]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "error"
      },
      "style": {
        "noInferrableTypes": "error",
        "noParameterAssign": "error"
      },
      "performance": {
        "useTopLevelRegex": "error"
      },
      "nursery": {
        "noConditionalExpect": "error",
        "useUnicodeRegex": "error",
        "useNamedCaptureGroup": "error",
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noUselessTypeConversion": "error",
        "useArraySome": "error",
        "useIncludes": "error",
        "useNullishCoalescing": "error",
        "useStringStartsEndsWith": "error",
        "useRegexpTest": "error",
        "useRegexpExec": "error",
        "noUnusedClasses": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**", "**/__tests__/**"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
